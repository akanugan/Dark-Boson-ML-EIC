# Preserve scientific CSV bytes and their recorded SHA-256 checksums.
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Historical unified-diff context lines deliberately contain spaces.
*.diff -whitespace

# Retain inherited EOF spacing in files copied into the version folders.
v1/requirements.txt whitespace=-blank-at-eof
v2/include/DarkBosonKinematics.h whitespace=-blank-at-eof
v2/config/paper_cuts.csv whitespace=blank-at-eol,space-before-tab,cr-at-eol,-blank-at-eof
