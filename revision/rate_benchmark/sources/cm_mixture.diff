   bool build_event(const double* x, darkboson::EventKinematics& event,
+                   double& density_pb) const {
+    if (!cfg_.cm_box_enabled) return build_event_base(x, event, density_pb);
+    // x is uniform on the unit hypercube. This many-to-one map samples y
+    // from q(y)=(1-p)+p/Vbox*Ibox(y), not a restricted physical domain.
+    const double p = cfg_.cm_box_probability;
+    std::array<double,4> y{};
+    const bool box_channel = x[0] < p;
+    for (std::size_t j=0;j<4;++j) {
+      const double u = j==0 ? (box_channel ? x[0]/p : (x[0]-p)/(1-p)) : x[j];
+      y[j] = box_channel ? cfg_.cm_box[2*j]+u*(cfg_.cm_box[2*j+1]-cfg_.cm_box[2*j]) : u;
+    }
+    if (!build_event_base(y.data(), event, density_pb)) return false;
+    double volume=1;
+    bool inside=true;
+    for (std::size_t j=0;j<4;++j) {
+      volume *= cfg_.cm_box[2*j+1]-cfg_.cm_box[2*j];
+      inside = inside && y[j]>=cfg_.cm_box[2*j] && y[j]<=cfg_.cm_box[2*j+1];
+    }
+    const double proposal_density = (1-p)+(inside ? p/volume : 0.0);
+    // Summing over both channel preimages gives q(y); divide ONCE by q.
+    // No separate branch Jacobian or box-volume factor belongs here.
+    density_pb /= proposal_density;
+    event.density_pb = density_pb;
+    return std::isfinite(density_pb) && event.finite();
+  }
