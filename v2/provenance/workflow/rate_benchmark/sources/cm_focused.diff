+    double t = 0.0, jacobian_t = 0.0;
+    if (cfg_.t_importance_center > 0.0) {
+      // Full-domain Cauchy importance map in log(t). This does NOT impose a
+      // t cut: its endpoints are the unchanged physical t_min_ and t_max_.
+      const double log_center = std::log(cfg_.t_importance_center);
+      const double width = cfg_.t_importance_width;
+      const double angle_lo = std::atan((std::log(t_min_) - log_center) / width);
+      const double angle_hi = std::atan((std::log(t_max_) - log_center) / width);
+      const double angle_span = angle_hi - angle_lo;
+      const double angle = angle_lo + x[0] * angle_span;
+      t = std::exp(log_center + width * std::tan(angle));
+      const double cosine = std::cos(angle);
+      jacobian_t = t * width * angle_span / (cosine * cosine);
+    } else {
+      t = t_min_ * std::exp(log_ratio * x[0]);
+      jacobian_t = t * log_ratio;
+    }
 
